# Copy to `.env` (git-ignored) for local development. For EAS builds define the same
# names with `eas env:create` (environments: development / preview / production).
# All EXPO_PUBLIC_* values are embedded in the client bundle: never put secrets here.

# Base URL of the Consulens API, WITHOUT the /api/v1 suffix (the client appends it).
# Physical devices cannot reach "localhost": use your LAN IP or a tunnel.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google OAuth client ids (Google Cloud Console > APIs & Services > Credentials).
# Web client id: required by Android/iOS to obtain an ID token and used on web.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# EAS project id (`eas init`), needed to obtain Expo push tokens.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional feature flag: set to "false" to hide the microphone button.
EXPO_PUBLIC_VOICE_INPUT=true
