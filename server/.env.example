# Copy to .env and fill in. Never commit the real .env.
#
# Where settings are read from (highest priority first):
#   1. real environment variables (Docker / your shell)
#   2. server/.env
#   3. <repository root>/.env
# Both files are optional and their paths don't depend on the working directory. A value in
# server/.env overrides the same key in the root .env. In Docker neither file exists in the
# image: pass environment variables (docker compose reads server/.env via env_file).

APP_ENV=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL 16, asyncpg driver) -------------------------------------------
DATABASE_URL=postgresql+asyncpg://consulens:consulens@localhost:5432/consulens
# Used by docker-compose.yml for the postgres container and the DATABASE_URL it builds.
POSTGRES_PASSWORD=consulens

# --- Auth -------------------------------------------------------------------------------
# REQUIRED, at least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated Google OAuth client IDs whose ID tokens are accepted (web, iOS, Android).
GOOGLE_CLIENT_IDS=
# First administrator, created at startup only if no admin exists yet (password 12-72 bytes).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- HTTP -------------------------------------------------------------------------------
# Comma-separated allowed origins for browsers (Expo web, admin web). Native apps don't need it.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- LLM (Anthropic Claude or OpenAI) ---------------------------------------------------
# auto (default): Anthropic if ANTHROPIC_API_KEY is set, otherwise OpenAI if OPENAI_API_KEY is set.
# anthropic | openai: force one provider (if its key is missing, runs proceed without an LLM).
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Leave empty for the provider default: claude-haiku-5-5 (anthropic) / gpt-6.2-sol (openai).
LLM_MODEL=
# Anthropic output_config.effort / OpenAI reasoning.effort. Default low.
#   Anthropic: low | medium | high | xhigh | max
#   OpenAI:    none | minimal | low | medium | high | xhigh (none only on gpt-6-luna and
#              gpt-6.1-terra; gpt-6.2-sol / gpt-6.2-astra reject it, so startup fails with a
#              configuration error if you set it for them)
LLM_EFFORT=low
# Model for the per-page verification step (same provider). Leave empty for the default:
# claude-haiku-5-5 (anthropic) / gpt-6-luna (openai). Same effort rules as LLM_EFFORT.
LLM_VERIFY_MODEL=
LLM_VERIFY_EFFORT=low

# --- Page verification -------------------------------------------------------------------
# Each NEW candidate result page is fetched (robots.txt respected, no JavaScript) and checked
# again by the verify model. Pages that can't be fetched keep the snippet result, unverified.
VERIFY_PAGES=true
VERIFY_USER_AGENT=ConsulensBot/1.0
VERIFY_TIMEOUT_SECONDS=10
VERIFY_MAX_BYTES=2000000
VERIFY_MAX_TEXT_CHARS=24000
VERIFY_CONCURRENCY=6
VERIFY_PER_DOMAIN_CONCURRENCY=2

# --- Web search (Serper.dev) ------------------------------------------------------------
# Without a key, searches end with last_run_status="no_provider" and no results are stored.
SERPER_API_KEY=
SEARCH_COUNTRY=it
SEARCH_RESULTS_PER_QUERY=10

# --- Push notifications (Expo) ----------------------------------------------------------
# Optional: only needed if "Enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=

# --- Stripe -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# --- Monitoring scheduler ---------------------------------------------------------------
# Run the scheduler inside the API process (dev convenience). In production run `python -m app.worker`.
RUN_SCHEDULER_IN_PROCESS=false
SCHEDULER_TICK_SECONDS=60
SCHEDULER_BATCH_SIZE=20
SCHEDULER_CONCURRENCY=4
SEARCH_LEASE_SECONDS=600
MANUAL_RUN_COOLDOWN_SECONDS=300
